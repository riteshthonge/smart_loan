PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smartloan_ai
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
FRONTEND_URL=http://localhost:5173
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENT_ENCRYPTION_KEY=replace_with_64_random_hex_characters
# Structural address diagnostics only; never prints recognized address lines.
OCR_DEBUG_ADDRESS=false
